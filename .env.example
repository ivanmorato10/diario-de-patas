# Diário de Patas — variáveis de ambiente. Copie para .env.local. NUNCA commitar valores reais.
# Sem nenhuma variável, o app roda em MODO DEMONSTRAÇÃO (dados só no navegador).

# --- Opcional agora ---
# Email exibido em "Sobre". Deixe vazio até existir um canal real (não inventar).
NEXT_PUBLIC_SUPPORT_EMAIL=

# --- Etapa C: Supabase (ainda não usado pelo código) ---
# URL e chave pública (anon) — podem ir ao navegador; a segurança vem das políticas RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave privilegiada — SOMENTE servidor. Nunca prefixar com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Etapa D: validador de fotos (provedor a escolher; ainda não usado) ---
PHOTO_VALIDATOR_PROVIDER=
PHOTO_VALIDATOR_API_KEY=
PHOTO_VALIDATOR_MODEL=

# --- Etapa E: geração de artes (provedor com referência de imagem; ainda não usado) ---
ART_GENERATOR_PROVIDER=
ART_GENERATOR_API_KEY=
# true pausa a geração mantendo o diário acessível
GENERATION_PAUSED=false
