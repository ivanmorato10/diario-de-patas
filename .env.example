# Diário de Patas — variáveis de ambiente. Copie para .env.local. NUNCA commitar valores reais.
# Sem nenhuma variável, o app roda em MODO DEMONSTRAÇÃO (dados só no navegador).

# --- Opcional agora ---
# Email exibido em "Sobre". Deixe vazio até existir um canal real (não inventar).
NEXT_PUBLIC_SUPPORT_EMAIL=diariodepatas.app@gmail.com

# --- Etapa C: Supabase (ainda não usado pelo código) ---
# URL e chave pública (anon) — podem ir ao navegador; a segurança vem das políticas RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave privilegiada — SOMENTE servidor. Nunca prefixar com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Estúdio com IA (MUDANCAS-V2 §9 + adendo): provedor Google Gemini. Chave SÓ aqui e no painel da Vercel. ---
ART_GENERATOR_PROVIDER=gemini
ART_GENERATOR_API_KEY=
# Opcional: trocar modelos sem deploy de código (padrões em src/config/studio.ts)
STUDIO_MODEL_NORMAL=
STUDIO_MODEL_PREMIUM=
STUDIO_MODEL_CHECK=
# Créditos de TESTE por conta (sem pagamento) e proteções de custo
# Créditos de boas-vindas, uma única vez por conta
STUDIO_TEST_CREDITS=3
STUDIO_DAILY_PER_ACCOUNT=5
STUDIO_MAX_DAILY_GENERATIONS=50
# Presets desligados sem deploy (também dá pela tabela studio_presets), separados por vírgula
STUDIO_DISABLED_PRESETS=
# true pausa a geração mantendo o diário acessível
GENERATION_PAUSED=false
# Limpeza diária (Vercel Cron)
CRON_SECRET=

# --- Email enviado pelo app (conta excluída). Use o MESMO SMTP configurado no Supabase (docs/SUPABASE.md §5). ---
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=seu@gmail.com, SMTP_PASS=senha de app (16 letras)
# Sem SMTP_HOST, o app simplesmente não envia esse email.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Entrar com Google (Supabase › Auth › Google). Usados só pelo `npx supabase config push`. ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Compra de créditos por Pix (Mercado Pago). Credenciais só aqui e na Vercel. ---
# Comece com o Access Token de TESTE (TEST-...). Sem PAYMENTS_ENABLED=true, a loja mostra "em breve".
PAYMENTS_ENABLED=false
MP_ACCESS_TOKEN=
# Chave secreta do webhook (Suas integrações › Webhooks), para validar as notificações
MP_WEBHOOK_SECRET=
# Só local: simula o Pix sem Mercado Pago (nunca na Vercel)
PAYMENTS_FAKE=

# --- Achadinhos do Abu: Amazon Creators API (foto e título oficiais). Só no .env.local e na Vercel. ---
# Associates Central › Tools › Creators API › aplicativo › credencial (versão 3.x). Sem vendas recentes a Amazon
# responde AssociateNotEligible e a página usa as ilustrações.
AMAZON_CREATORS_CREDENTIAL_ID=
AMAZON_CREATORS_CREDENTIAL_SECRET=
AMAZON_PARTNER_TAG=biancaassunca-20
